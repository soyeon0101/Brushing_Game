  _nextButton: {fileID: 781922274}
  _nextLabel: {fileID: 352345301}
  _skipButton: {fileID: 963826244}
  _storyPages:
  - text: "\uC544\uC8FC \uBA3C \uC6B0\uC8FC\uC5D0\n\uBC18\uC9DD\uBC18\uC9DD \uC774\uBE68
      \uD589\uC131\uC774 \uC788\uC5C8\uC5B4\uC694.\n\uCE5C\uAD6C\uB4E4\uC740 \uB9E4\uC77C
      \uC6C3\uC73C\uBA70 \uC9C0\uB0C8\uC9C0\uC694."
    arts:
    - characterId: prince
      art: {fileID: 21300000, guid: 151258397eb26bf4abee471038b1d4f2, type: 3}
    - characterId: princess
      art: {fileID: 21300000, guid: 851c07a724067e74a82b98eaf89e5a15, type: 3}
    brushSec: 1.5
    measure: 0
    guide: "\uCE6B\uC194 \uB4E0 \uC190\uC744 \uD754\uB4E4\uBA74 \uB2E4\uC74C \uC7A5\uC73C\uB85C
      \uB118\uC5B4\uAC00!"
    buttonLabel: 
  - text: "\uADF8\uB7F0\uB370 \uCDA9\uCE58\uADE0\uB4E4\uC774 \uBAB0\uB824\uC640\n\uCE5C\uAD6C\uB4E4\uC758
      \uC774\uB97C \uC544\uD504\uAC8C\n\uD558\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694!"
    arts:
    - characterId: prince
      art: {fileID: 21300000, guid: 143df5d9cdee04b49b5f2fa90718e9ab, type: 3}
    - characterId: princess
      art: {fileID: 21300000, guid: 3ac2192d8c8ac7d4186a80c90b18a98d, type: 3}
    brushSec: 3.5
    measure: 1
    guide: "\uCE6B\uC194\uC744 \uC785\uC5D0 \uB123\uACE0 \uC2A5\uC0AD\uC2A5\uC0AD
      \uCAD3\uC544\uB0B4 \uBD10!"
    buttonLabel: 
  - text: "\uC6B0\uC8FC \uCE58\uACFC\uC5D0\n\uB3C4\uC640 \uB2EC\uB77C\uB294 \uC5F0\uB77D\uC774
      \uC654\uC5B4\uC694!\n{0}, \uCDA9\uCE58\uADE0\uC744 \uBB3C\uB9AC\uCE58\uB7EC
      \uAC00\uC790!"
    arts:
    - characterId: prince
      art: {fileID: 21300000, guid: 0dc2bbae7d557f44d88dc34b42ad34bb, type: 3}
    - characterId: princess
      art: {fileID: 21300000, guid: 6d23ef5ad0f10f8419115c4b148e8513, type: 3}
    brushSec: 3.5
    measure: 1
    guide: "\uD3C9\uC18C\uCC98\uB7FC \uC2A5\uC0AD\uC2A5\uC0AD!"
    buttonLabel: 
  - text: "\uC774\uC81C {0}\uB3C4\n\uC6B0\uC8FC \uCE58\uACFC\uC758 \uCE58\uACFC\uC758\uC0AC\uC608\uC694!\n\uC544\uD508
      \uCE5C\uAD6C\uB4E4\uC744 \uB3C4\uC640\uC904\uB798\uC694?"
    arts:
