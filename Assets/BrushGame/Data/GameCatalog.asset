    mouthTop: {fileID: 0}
    mouthBottom: {fileID: 0}
    requestLine: "\uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB358 \uC774\uAC00 \uBE5B\uC744
      \uC783\uC5C8\uC5B4\u2026 \uB3C4\uC640\uC918!"
    thanksLine: "\uBC1D\uAC8C \uBE5B\uB098\uC694, \uBC14\uB974\uAC8C \uB2E6\uC544\uC694!"
